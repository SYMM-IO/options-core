{
	"name": "options-core",
	"version": "1.0.0",
	"description": "",
	"license": "MIT",
	"author": {
		"name": "MoonKnight/Naveedinno",
		"url": "https://github.com/SYMM-IO/options-core"
	},
	"devDependencies": {
		"@nomicfoundation/hardhat-ethers": "^4.2.0",
		"@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
		"@nomicfoundation/hardhat-ignition": "^3.1.8",
		"@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
		"@nomicfoundation/hardhat-keystore": "^3.1.1",
		"@nomicfoundation/hardhat-mocha": "^4.0.0",
		"@nomicfoundation/hardhat-network-helpers": "^3.0.11",
		"@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
		"@nomicfoundation/hardhat-typechain": "^3.1.1",
		"@nomicfoundation/hardhat-verify": "^3.1.2",
		"@nomicfoundation/ignition-core": "^3.1.10",
		"@openzeppelin/contracts": "5.6.1",
		"@openzeppelin/contracts-upgradeable": "5.6.1",
		"@openzeppelin/hardhat-upgrades": "^4.1.0",
		"@secretlint/secretlint-rule-no-dotenv": "^13.0.7",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
		"@secretlint/secretlint-rule-privatekey": "^13.0.7",
		"@secretlint/secretlint-rule-secp256k1-privatekey": "^13.0.7",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.19.1",
		"builder-pattern": "^2.2.0",
		"chai": "^6.3.0",
		"dotenv": "^18.0.5",
		"ethers": "^6.17.0",
		"hardhat": "^3.18.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"mocha": "^12.0.3",
		"prettier": "^3.9.9",
		"prettier-plugin-solidity": "^2.4.1",
		"secretlint": "^13.0.7",
		"shx": "^0.4.0",
		"solhint": "^6.2.4",
		"typescript": "^7.0.2"
	},
	"files": [
		"/contracts"
	],
	"keywords": [
		"defi",
		"ethereum",
		"hardhat",
		"smart-contracts",
		"solidity",
		"typescript"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "hardhat clean && shx rm -rf ./types ./coverage ./coverage.json",
		"compile": "symsec --project options-core run npx hardhat compile",
		"coverage": "hardhat test --coverage",
		"lint": "npm run lint:sol && npm run typecheck",
		"lint:sol": "solhint --config ./.solhint.json --max-warnings 0 \"contracts/**/*.sol\"",
		"test": "symsec --project options-core run npx hardhat test",
		"test:uncheck-muon": "./utils/runTest.sh",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"precommit": "symsec --project options-core run npm run format && symsec --project options-core run npm run compile && symsec --project options-core run npm test",
		"typecheck": "tsc --noEmit -p ."
	},
	"lint-staged": {
		"*": "secretlint"
	},
	"type": "module"
}
