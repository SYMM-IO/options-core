	},
	"devDependencies": {
		"@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
		"@nomicfoundation/hardhat-ethers": "^3.1.3",
		"@nomicfoundation/hardhat-ignition": "^0.15.16",
		"@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
		"@nomicfoundation/hardhat-network-helpers": "^1.1.2",
		"@nomicfoundation/hardhat-verify": "^2.1.3",
		"@nomicfoundation/ignition-core": "^0.15.15",
		"@openzeppelin/contracts": "5.6.1",
		"@openzeppelin/contracts-upgradeable": "5.6.1",
		"@openzeppelin/hardhat-upgrades": "^3.9.1",
		"@typechain/ethers-v6": "^0.5.1",
		"@typechain/hardhat": "^9.1.0",
		"@types/chai": "^4.3.20",
		"@types/fs-extra": "^11.0.4",
		"@types/mocha": "^10.0.10",
		"@types/node": "^20.19.43",
		"bignumber.js": "^9.3.1",
		"builder-pattern": "^2.2.0",
		"chai": "^4.5.0",
		"cross-env": "^7.0.3",
		"dotenv": "^16.6.1",
		"ethers": "^6.17.0",
		"fs-extra": "^11.4.1",
		"hardhat-gas-reporter": "^1.0.10",
		"husky": "^9.1.7",
		"js-sha3": "^0.9.3",
		"lint-staged": "^16.4.0",
		"mocha": "^10.8.2",
		"prettier": "^3.9.9",
		"prettier-plugin-solidity": "^2.4.1",
		"random-ext": "^2.8.0",
		"rxjs": "^7.8.2",
		"secretlint": "^9.3.4",
		"shx": "^0.3.4",
		"solidity-coverage": "^0.8.17",
		"solidity-docgen": "^0.6.0-beta.36",
		"ts-node": "^10.9.2",
		"typechain": "^8.3.2",
		"typescript": "^5.9.3",
		"typescript-json-serializer": "^6.0.1",
		"winston": "^3.19.0"
	},
	"files": [
		"/contracts"
	],
	"keywords": [
		"defi",
		"ethereum",
		"hardhat",
		"smart-contracts",
		"solidity",
		"typescript"
	],
	"packageManager": "yarn@1.22.22",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "shx rm -rf ./artifacts ./cache ./coverage ./src/types ./coverage.json && yarn typechain",
		"compile": "symsec --project options-core run npx hardhat compile",
		"coverage": "hardhat coverage --testfiles \"tests/**/*.ts\"",
		"lint": "yarn lint:sol && yarn lint:ts",
		"lint:sol": "solhint --config ./.solhint.json --max-warnings 0 \"contracts/**/*.sol\"",
		"test": "symsec --project options-core run npx hardhat test",
		"test:uncheck-muon": "./utils/runTest.sh",
		"typechain": "symsec --project options-core run npx hardhat typechain",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"precommit": "symsec --project options-core run yarn format && symsec --project options-core run  yarn compile && symsec --project options-core run  yarn test",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@nomicfoundation/hardhat-toolbox": "^5.0.0",
		"@secretlint/secretlint-rule-no-dotenv": "^9.3.4",
		"@secretlint/secretlint-rule-preset-recommend": "^9.3.4",
		"@secretlint/secretlint-rule-privatekey": "^9.3.4",
		"@secretlint/secretlint-rule-secp256k1-privatekey": "^9.3.4",
		"hardhat": "^2.29.1",
		"solhint": "^5.2.0"
	},
	"lint-staged": {
		"*": "secretlint"
	}
}
